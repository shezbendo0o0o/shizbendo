#!/usr/bin/env python3
from __future__ import annotations

import fcntl
import os
import pty
import select
import signal
import struct
import sys
import termios
import tty
from collections.abc import Iterable


DEFAULT_COMMAND = [
    "/root/.local/bin/decepticon",
]


REPLACEMENTS = (
    (
        b"Decepticon",
        b"Shizbendo",
    ),
    (
        b"DECEPTICON",
        b"SHIZBENDO",
    ),
    (
        b"decepticon",
        b"shizbendo",
    ),
    (
        b"0;1u",
        b"",
    ),
    (
        b"ctrl+o: expand  ctrl+c: exit",
        b"Ctrl+O: expand  \xe2\x80\xa2  Ctrl+C: exit",
    ),
)


class StreamingReplacer:
    def __init__(
        self,
        replacements: Iterable[
            tuple[bytes, bytes]
        ],
    ) -> None:
        self.replacements = tuple(replacements)
        self.pending = bytearray()

    def feed(
        self,
        data: bytes,
        *,
        final: bool = False,
    ) -> bytes:
        self.pending.extend(data)
        output = bytearray()

        while self.pending:
            exact = next(
                (
                    pair
                    for pair in self.replacements
                    if self.pending.startswith(
                        pair[0]
                    )
                ),
                None,
            )

            if exact is not None:
                source, target = exact

                if len(self.pending) >= len(source):
                    del self.pending[
                        : len(source)
                    ]
                    output.extend(target)
                    continue

            possible_prefix = any(
                source.startswith(self.pending)
                for source, _ in self.replacements
            )

            if possible_prefix and not final:
                break

            output.append(self.pending[0])
            del self.pending[0]

        return bytes(output)


def window_size(fd: int) -> bytes:
    try:
        return fcntl.ioctl(
            fd,
            termios.TIOCGWINSZ,
            b"\0" * 8,
        )
    except OSError:
        return struct.pack(
            "HHHH",
            32,
            120,
            0,
            0,
        )


def rows_and_columns(
    size: bytes,
) -> tuple[int, int]:
    rows, columns, _, _ = struct.unpack(
        "HHHH",
        size,
    )

    return (
        max(rows, 24),
        max(columns, 80),
    )


def apply_window_size(
    target_fd: int,
    size: bytes,
) -> None:
    fcntl.ioctl(
        target_fd,
        termios.TIOCSWINSZ,
        size,
    )


def write_all(
    fd: int,
    data: bytes,
) -> None:
    remaining = memoryview(data)

    while remaining:
        written = os.write(fd, remaining)
        remaining = remaining[written:]


def main() -> int:
    command = sys.argv[1:] or DEFAULT_COMMAND

    stdin_fd = sys.stdin.fileno()
    stdout_fd = sys.stdout.fileno()

    source_fd = (
        stdout_fd
        if os.isatty(stdout_fd)
        else stdin_fd
    )

    size = window_size(source_fd)
    rows, columns = rows_and_columns(size)

    pid, master_fd = pty.fork()

    if pid == 0:
        try:
            apply_window_size(
                sys.stdout.fileno(),
                size,
            )
        except OSError:
            pass

        environment = os.environ.copy()

        if environment.get(
            "TERM",
            "",
        ) in ("", "dumb"):
            environment["TERM"] = (
                "xterm-256color"
            )

        environment["COLORTERM"] = "truecolor"
        environment["FORCE_COLOR"] = "3"
        environment["COLUMNS"] = str(columns)
        environment["LINES"] = str(rows)
        environment["PYTHONUNBUFFERED"] = "1"

        environment.pop("NO_COLOR", None)

        os.execvpe(
            command[0],
            command,
            environment,
        )

    apply_window_size(master_fd, size)

    def resize_handler(
        _signum: int,
        _frame: object,
    ) -> None:
        try:
            new_size = window_size(source_fd)

            apply_window_size(
                master_fd,
                new_size,
            )

            os.kill(
                pid,
                signal.SIGWINCH,
            )

        except (
            OSError,
            ProcessLookupError,
        ):
            pass

    signal.signal(
        signal.SIGWINCH,
        resize_handler,
    )

    old_terminal_settings = None

    if os.isatty(stdin_fd):
        old_terminal_settings = (
            termios.tcgetattr(stdin_fd)
        )

        tty.setraw(
            stdin_fd,
            when=termios.TCSANOW,
        )

    replacer = StreamingReplacer(
        REPLACEMENTS
    )

    try:
        while True:
            readable, _, _ = select.select(
                [
                    master_fd,
                    stdin_fd,
                ],
                [],
                [],
                0.25,
            )

            if master_fd in readable:
                try:
                    output = os.read(
                        master_fd,
                        65536,
                    )
                except OSError:
                    output = b""

                if not output:
                    break

                polished = replacer.feed(output)

                if polished:
                    write_all(
                        stdout_fd,
                        polished,
                    )

            if stdin_fd in readable:
                try:
                    keyboard_input = os.read(
                        stdin_fd,
                        65536,
                    )
                except OSError:
                    keyboard_input = b""

                if not keyboard_input:
                    break

                # Keyboard input is forwarded immediately.
                write_all(
                    master_fd,
                    keyboard_input,
                )

    finally:
        remaining = replacer.feed(
            b"",
            final=True,
        )

        if remaining:
            write_all(
                stdout_fd,
                remaining,
            )

        if old_terminal_settings is not None:
            termios.tcsetattr(
                stdin_fd,
                termios.TCSADRAIN,
                old_terminal_settings,
            )

        try:
            os.close(master_fd)
        except OSError:
            pass

    _, status = os.waitpid(pid, 0)

    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)

    if os.WIFSIGNALED(status):
        return (
            128 +
            os.WTERMSIG(status)
        )

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
