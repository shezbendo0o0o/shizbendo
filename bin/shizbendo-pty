#!/usr/bin/env python3

import errno
import fcntl
import os
import pty
import selectors
import signal
import sys
import termios
import tty

REPLACEMENTS = (
    (b"Decepticon", b"Shizbendo"),
    (b"DECEPTICON", b"SHIZBENDO"),
    (b"decepticon", b"shizbendo"),
)

CARRY_SIZE = max(
    len(source)
    for source, _target in REPLACEMENTS
) - 1


def transform(data: bytes) -> bytes:
    for source, target in REPLACEMENTS:
        data = data.replace(source, target)

    return data


def write_all(file_descriptor: int, data: bytes) -> None:
    while data:
        written = os.write(file_descriptor, data)
        data = data[written:]


def copy_window_size(source_fd: int, target_fd: int) -> None:
    try:
        size = fcntl.ioctl(
            source_fd,
            termios.TIOCGWINSZ,
            b"\0" * 8,
        )

        fcntl.ioctl(
            target_fd,
            termios.TIOCSWINSZ,
            size,
        )
    except OSError:
        pass


def main() -> int:
    if len(sys.argv) < 2:
        print(
            "Usage: shizbendo-pty COMMAND [ARGS...]",
            file=sys.stderr,
        )
        return 2

    command = sys.argv[1:]

    stdin_fd = sys.stdin.fileno()
    stdout_fd = sys.stdout.fileno()

    if not os.isatty(stdin_fd):
        os.execvpe(
            command[0],
            command,
            os.environ.copy(),
        )

    original_terminal = termios.tcgetattr(stdin_fd)

    child_pid, master_fd = pty.fork()

    if child_pid == 0:
        environment = os.environ.copy()
        environment["TERM"] = environment.get(
            "TERM",
            "xterm-256color",
        )

        os.execvpe(
            command[0],
            command,
            environment,
        )

    selector = selectors.DefaultSelector()
    carry = b""
    master_open = True

    def resize_terminal(
        _signal_number=None,
        _frame=None,
    ) -> None:
        copy_window_size(stdin_fd, master_fd)

        try:
            os.killpg(child_pid, signal.SIGWINCH)
        except ProcessLookupError:
            pass

    def forward_signal(signal_number, _frame) -> None:
        try:
            os.killpg(child_pid, signal_number)
        except ProcessLookupError:
            pass

    signal.signal(signal.SIGWINCH, resize_terminal)
    signal.signal(signal.SIGHUP, forward_signal)
    signal.signal(signal.SIGTERM, forward_signal)

    copy_window_size(stdin_fd, master_fd)

    selector.register(
        stdin_fd,
        selectors.EVENT_READ,
        "stdin",
    )

    selector.register(
        master_fd,
        selectors.EVENT_READ,
        "master",
    )

    try:
        tty.setraw(stdin_fd)

        while master_open:
            for key, _events in selector.select():
                if key.data == "stdin":
                    try:
                        data = os.read(stdin_fd, 4096)
                    except OSError:
                        data = b""

                    if not data:
                        try:
                            selector.unregister(stdin_fd)
                        except Exception:
                            pass
                        continue

                    try:
                        write_all(master_fd, data)
                    except OSError:
                        master_open = False
                        break

                elif key.data == "master":
                    try:
                        data = os.read(master_fd, 65536)
                    except OSError as error:
                        if error.errno == errno.EIO:
                            data = b""
                        else:
                            raise

                    if not data:
                        master_open = False
                        break

                    combined = carry + data

                    if len(combined) <= CARRY_SIZE:
                        carry = combined
                        continue

                    safe_length = (
                        len(combined) - CARRY_SIZE
                    )

                    output = combined[:safe_length]
                    carry = combined[safe_length:]

                    write_all(
                        stdout_fd,
                        transform(output),
                    )

        if carry:
            write_all(
                stdout_fd,
                transform(carry),
            )

    finally:
        termios.tcsetattr(
            stdin_fd,
            termios.TCSADRAIN,
            original_terminal,
        )

        selector.close()

        try:
            os.close(master_fd)
        except OSError:
            pass

    try:
        _finished_pid, status = os.waitpid(
            child_pid,
            0,
        )
    except ChildProcessError:
        return 0

    return os.waitstatus_to_exitcode(status)


if __name__ == "__main__":
    raise SystemExit(main())
